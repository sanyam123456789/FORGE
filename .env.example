# ============================================================
# FORGE — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- LLM Provider (single-provider / legacy) ---------------
# Used when FORGE_PROVIDER_ORDER (below) is empty/unset.
# Implemented adapters: gemini | groq | cerebras
# Also accepted (no adapter yet): openai | anthropic | google | openai_compatible
FORGE_LLM_PROVIDER=gemini

# Model name as accepted by the provider API
FORGE_LLM_MODEL=gemini-3.6-flash

# Your Gemini API key. This is the same key used whether Gemini is the sole
# provider or the primary provider in FORGE_PROVIDER_ORDER below.
# The Gemini adapter also falls back to GEMINI_API_KEY / GOOGLE_API_KEY.
FORGE_LLM_API_KEY=your-api-key-here

# Optional: custom base URL for OpenAI-compatible endpoints
# FORGE_LLM_BASE_URL=https://api.openai.com/v1

# ----- Multi-provider fallback (opt-in) ----------------------
# Leave FORGE_PROVIDER_ORDER empty/unset to keep the exact single-provider
# behavior above (Gemini only, no fallback) — this is the default and does
# not change any existing FORGE behavior.
#
# To enable Gemini -> Groq -> Cerebras fallback (Gemini primary, Groq first
# fallback, Cerebras second fallback), uncomment and set all three keys:
# FORGE_PROVIDER_ORDER=gemini,groq,cerebras

# Groq API key. Only used when "groq" appears in FORGE_PROVIDER_ORDER (or
# FORGE_LLM_PROVIDER=groq directly). Read only from this variable.
FORGE_GROQ_API_KEY=

# Groq model. Must be explicitly set to a model that supports tool/function
# calling — check https://console.groq.com/docs/models for the current
# list; FORGE does not assume a default.
FORGE_GROQ_MODEL=

# Cerebras API key. Only used when "cerebras" appears in
# FORGE_PROVIDER_ORDER (or FORGE_LLM_PROVIDER=cerebras directly). Read only
# from this variable.
FORGE_CEREBRAS_API_KEY=

# Cerebras model. Must be explicitly set to a model that supports
# tool/function calling — check https://inference-docs.cerebras.ai/models
# for the current list; FORGE does not assume a default.
FORGE_CEREBRAS_MODEL=

# Optional: how many times each adapter retries a transient error (rate
# limit, quota, 5xx, connection/timeout) before FallbackProvider moves to
# the next provider in the order.
# FORGE_PROVIDER_RETRY_MAX=3

# Optional: per-request timeout in seconds, passed to the provider SDK.
# Unset uses the SDK's own default.
# FORGE_LLM_REQUEST_TIMEOUT_S=60

# ----- LLM Generation --------------------------------------
# Sampling temperature (0.0 = deterministic). Range 0.0 - 2.0.
FORGE_LLM_TEMPERATURE=0.0

# Max output tokens per LLM call.
FORGE_LLM_MAX_OUTPUT_TOKENS=4096

# ----- Runtime Settings -------------------------------------
# Maximum tool calls per agent run (safety ceiling)
FORGE_MAX_TOOL_CALLS=50

# Maximum LLM turns per agent run
FORGE_MAX_LLM_TURNS=30

# Workspace root — agent file operations are restricted to this path
# Defaults to the directory FORGE is launched from if not set
# FORGE_WORKSPACE_ROOT=/path/to/your/project

# ----- Logging ----------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
FORGE_LOG_LEVEL=INFO

# Log format: text | json
FORGE_LOG_FORMAT=text

# Directory where FORGE writes run logs and traces (relative to repo root)
FORGE_LOG_DIR=logs
