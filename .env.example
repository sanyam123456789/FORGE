# ============================================================
# FORGE — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- LLM Provider: OpenCode Go (OpenAI-compatible) -----
FORGE_LLM_PROVIDER=opencode_go
FORGE_LLM_MODEL=deepseek-v4.1-flash
# Your OpenCode Go API key (https://opencode.ai/auth). Either variable works.
FORGE_LLM_API_KEY=
# OPENCODE_API_KEY=
# Optional override (default: https://opencode.ai/zen/go/v1)
# FORGE_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# Note: OpenCode Go's MiniMax model uses an Anthropic-style endpoint and is NOT supported by this provider.
#
# ----- Alternative: any OpenAI-compatible endpoint (e.g. local Ollama) -----
# FORGE_LLM_PROVIDER=openai_compatible
# FORGE_LLM_BASE_URL=http://localhost:11434/v1
# FORGE_LLM_MODEL=qwen2.5-coder:7b
# FORGE_LLM_API_KEY=ollama

# ----- Retries / timeout ------------------------------------
# Optional: how many times the provider retries a transient error (rate
# limit, 5xx, connection/timeout) before giving up. Backoff is 2s, 4s, 8s...
# and honors a Retry-After header.
# FORGE_PROVIDER_RETRY_MAX=3

# Optional: per-request timeout in seconds. Unset uses 120.
# FORGE_LLM_REQUEST_TIMEOUT_S=120

# ----- LLM Generation --------------------------------------
# Sampling temperature (0.0 = deterministic). Range 0.0 - 2.0.
FORGE_LLM_TEMPERATURE=0.0

# Max output tokens per LLM call. 0 = no cap (default).
FORGE_LLM_MAX_OUTPUT_TOKENS=0

# ----- Runtime Settings -------------------------------------
# Loop guards: stop a run that gets stuck repeating itself. 0 = unlimited.
# Maximum tool calls per agent run
FORGE_MAX_TOOL_CALLS=50

# Maximum LLM turns per agent run
FORGE_MAX_LLM_TURNS=30

# Workspace root — agent file operations are restricted to this path
# Defaults to the directory FORGE is launched from if not set
# FORGE_WORKSPACE_ROOT=/path/to/your/project

# ----- Token savers -----------------------------------------
# Add a short list of workspace files to the first message, so the agent
# does not spend turns exploring. true (default) / false.
# FORGE_REPO_MAP=true

# ----- Shell security ---------------------------------------
# Extra env var names (comma-separated) passed to run_shell commands, even if they look like secrets; FORGE_* is never passed.
# FORGE_SHELL_ENV_ALLOW=

# ----- Logging ----------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
FORGE_LOG_LEVEL=INFO

# Log format: text | json
FORGE_LOG_FORMAT=text

# Directory where FORGE writes run logs and traces (relative to repo root)
FORGE_LOG_DIR=logs
