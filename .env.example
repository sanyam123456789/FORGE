# ============================================================
# FORGE — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- LLM Provider -----------------------------------------
# Current provider: gemini
# Also accepted (no adapter yet): openai | anthropic | google | openai_compatible
FORGE_LLM_PROVIDER=gemini

# Model name as accepted by the provider API
FORGE_LLM_MODEL=gemini-2.0-flash

# Your API key for the chosen provider.
# For Gemini the adapter also falls back to GEMINI_API_KEY / GOOGLE_API_KEY.
FORGE_LLM_API_KEY=your-api-key-here

# Optional: custom base URL for OpenAI-compatible endpoints
# FORGE_LLM_BASE_URL=https://api.openai.com/v1

# ----- LLM Generation --------------------------------------
# Sampling temperature (0.0 = deterministic). Range 0.0 - 2.0.
FORGE_LLM_TEMPERATURE=0.0

# Max output tokens per LLM call.
FORGE_LLM_MAX_OUTPUT_TOKENS=4096

# ----- Runtime Settings -------------------------------------
# Maximum tool calls per agent run (safety ceiling)
FORGE_MAX_TOOL_CALLS=50

# Maximum LLM turns per agent run
FORGE_MAX_LLM_TURNS=30

# Workspace root — agent file operations are restricted to this path
# Defaults to the directory FORGE is launched from if not set
# FORGE_WORKSPACE_ROOT=/path/to/your/project

# ----- Logging ----------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
FORGE_LOG_LEVEL=INFO

# Log format: text | json
FORGE_LOG_FORMAT=text

# Directory where FORGE writes run logs and traces (relative to repo root)
FORGE_LOG_DIR=logs
